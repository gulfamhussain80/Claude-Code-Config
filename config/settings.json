{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "additionalDirectories": ["~/.claude/skills"],
    "allow": [
      "Bash",
      "PowerShell",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Agent",
      "mcp__playwright__*",
      "mcp__firecrawl__firecrawl_search",
      "mcp__firecrawl__firecrawl_scrape",
      "mcp__firecrawl__firecrawl_map"
    ],
    "deny": [
      "Agent(quick)",
      "Agent(boss)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/id_rsa*)",
      "Read(*.pem)",
      "Read(*.env)",
      "Read(*.env.*)",
      "Read(!*.env.example)",

      "Edit(.git/**)",
      "Edit(**/node_modules/**)",
      "Edit(**/.venv/**)",
      "Edit(.claude/**)",
      "Edit(~/.claude/skills/**)",

      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git config --global *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(npm publish *)",
      "Bash(npm login *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh repo delete *)",
      "Bash(gh release *)",
      "Bash(cargo publish *)",
      "Bash(twine *)",
      "Bash(gem push *)",
      "Bash(dotnet nuget push *)",
      "Bash(mvn deploy *)",
      "Bash(aws *)",
      "Bash(az *)",
      "Bash(gcloud *)",
      "Bash(powershell *)",
      "Bash(pwsh *)",
      "Bash(cmd *)",
      "Bash(shutdown *)",
      "Bash(taskkill *)",
      "Bash(sc.exe *)",
      "Bash(reg *)",
      "Bash(reg.exe *)",
      "Bash(icacls *)",
      "Bash(takeown *)",
      "Bash(net user *)",
      "Bash(net localgroup *)",
      "Bash(schtasks *)",
      "Bash(netsh *)",
      "Bash(wmic *)",
      "Bash(diskpart *)",
      "Bash(fsutil *)",
      "Bash(vssadmin *)",
      "Bash(format *)",
      "Bash(bcdedit *)",

      "PowerShell(Remove-Item *)",
      "PowerShell(Clear-Content *)",
      "PowerShell(Clear-Item *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git config --global *)",
      "PowerShell(Invoke-Expression *)",
      "PowerShell(Invoke-Command *)",
      "PowerShell(Invoke-Item *)",
      "PowerShell(Start-Process *)",
      "PowerShell(Add-Type *)",
      "PowerShell(powershell *)",
      "PowerShell(pwsh *)",
      "PowerShell(cmd *)",
      "PowerShell(Set-ExecutionPolicy *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(npm publish *)",
      "PowerShell(npm login *)",
      "PowerShell(gh auth *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh release *)",
      "PowerShell(cargo publish *)",
      "PowerShell(twine *)",
      "PowerShell(gem push *)",
      "PowerShell(dotnet nuget push *)",
      "PowerShell(mvn deploy *)",
      "PowerShell(Get-Credential *)",
      "PowerShell(aws *)",
      "PowerShell(az *)",
      "PowerShell(gcloud *)",
      "PowerShell(Stop-Process *)",
      "PowerShell(taskkill *)",
      "PowerShell(Stop-Service *)",
      "PowerShell(Start-Service *)",
      "PowerShell(Set-Service *)",
      "PowerShell(New-Service *)",
      "PowerShell(sc.exe *)",
      "PowerShell(Restart-Computer *)",
      "PowerShell(Stop-Computer *)",
      "PowerShell(shutdown *)",
      "PowerShell(Set-ItemProperty *)",
      "PowerShell(New-ItemProperty *)",
      "PowerShell(Remove-ItemProperty *)",
      "PowerShell(reg *)",
      "PowerShell(reg.exe *)",
      "PowerShell(Set-Acl *)",
      "PowerShell(icacls *)",
      "PowerShell(takeown *)",
      "PowerShell(net user *)",
      "PowerShell(net localgroup *)",
      "PowerShell(schtasks *)",
      "PowerShell(Register-ScheduledTask *)",
      "PowerShell(Set-MpPreference *)",
      "PowerShell(Add-MpPreference *)",
      "PowerShell(netsh *)",
      "PowerShell(wmic *)",
      "PowerShell(diskpart *)",
      "PowerShell(fsutil *)",
      "PowerShell(vssadmin *)",
      "PowerShell(format *)",
      "PowerShell(bcdedit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude-config-guard.cjs\""
          }
        ]
      }
    ]
  }
}
